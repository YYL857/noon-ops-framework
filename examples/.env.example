# Absolute path to Service Account JSON from Noon Access App (never commit the JSON)
NOON_CREDENTIALS_FILE=C:\path\to\noon_credentials_sensitive.json

# Optional Partner API overrides
# NOON_API_BASE=https://noon-api-gateway.noon.partners
# NOON_USER_AGENT=noon-ops-framework/0.2
# NOON_IMPEX_COOLDOWN_MS=1800000

# Portal CSV inbox (Path B)
# NOON_PORTAL_IMPORTS_DIR=./data/portal-imports

# Seller Lab discovery (Playwright persistent profile)
# NOON_BROWSER_PROFILE=C:\path\to\noon-browser-profile
# NOON_DISCOVER_HEADLESS=1
# NOON_DISCOVER_MAX_PAGES=30

# PW session cookie health
# NOON_PW_STORAGE_STATE=C:\path\to\storage_state.json
# NOON_PW_SESSION_WARN_MS=172800000

# IMAP OTP helper (Python tools/pw-session/email_otp.py)
# NOON_OTP_IMAP_HOST=imap.example.com
# NOON_OTP_IMAP_PORT=993
# NOON_OTP_IMAP_USER=
# NOON_OTP_IMAP_PASS=
# NOON_OTP_IMAP_WAIT_SEC=180
